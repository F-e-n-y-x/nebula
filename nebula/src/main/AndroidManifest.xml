<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Frame generation (:framegen) needs API 29; the engine checks before using it. -->
    <uses-sdk tools:overrideLibrary="com.limelight.framegen" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Keeps a stream alive while the app is in the background (ongoing notification). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Microphone passthrough to the PC ("Nova Mic"); asked for at first use in the stream menu. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Host game rumble and audio haptics on this device (controllers need no permission). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Scanning a controls-layout QR code (asked for when the scanner opens; nothing is recorded). -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Settings → About installs Nebula updates (downloaded, checksum- and signer-verified) through
         PackageInstaller; the user confirms every install and must allow "Install unknown apps". -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Makes the system package installer visible so the updater can check that the install
         confirmation screen it launches belongs to a system app. -->
    <queries>
        <intent>
            <action android:name="android.content.pm.action.CONFIRM_INSTALL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSTALL_PACKAGE" />
            <data android:scheme="content" />
        </intent>
    </queries>

    <!-- One APK for phone, tablet and TV: touch is optional, leanback is supported but not required. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Watch Next: find the TV launcher so it can be granted read access to poster files. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:name=".NebulaApplication"
        android:allowBackup="false"
        android:banner="@drawable/atv_banner"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher_nebula"
        android:roundIcon="@mipmap/ic_launcher_nebula_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nebula">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- nebula://layout?url=https://… opens a shared controls layout. The link only names
                 a file to download: it is fetched over https (size-capped), validated, previewed,
                 and added only when the user taps Add. Nothing else in the intent is used. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nebula" android:host="layout" />
            </intent-filter>
            <!-- Quick connect: nebula://play/<host>/<app>?display=virtual|mirror. Validated in the app:
                 only a game on an already paired host ever starts (DeepLinks.resolve). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nebula" android:host="play" />
            </intent-filter>
        </activity>

        <!-- Quick Settings tile: resume the last game. Only the system can bind it. -->
        <service
            android:name=".quick.ResumeTileService"
            android:exported="true"
            android:icon="@drawable/ic_nebula_star"
            android:label="@string/tile_resume_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>

        <!-- Home-screen widget with the last three games (Glance). -->
        <receiver
            android:name=".quick.RecentGamesWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_recent_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/recent_games_widget_info" />
        </receiver>

        <!-- Watch Next posters for the TV launcher: private, read grants per URI only. -->
        <provider
            android:name=".quick.PosterFileProvider"
            android:authorities="${applicationId}.posters"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/poster_paths" />
        </provider>

        <service
            android:name=".StreamKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Clipboard sync: images copied on the PC are written to cache/clipboard and shared from here. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.clipboard_fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/clipboard_file_paths" />
        </provider>

        <!-- PackageInstaller status for self-updates; only reachable through Nebula's own PendingIntent. -->
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />

        <!-- Controls editor → Share: layout files and preview images, from cache/layouts only. -->
        <provider
            android:name=".controls.ui.LayoutFileProvider"
            android:authorities="${applicationId}.layouts"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- "Game running on your PC" notification actions (Stop, Don't notify, swipe-away). Not
             exported: reached only through Nebula's own immutable PendingIntents. -->
        <receiver
            android:name=".nowplaying.RunningGameActionReceiver"
            android:exported="false" />

        <!-- Settings → Diagnostics: the exported zip is shared from cache/diagnostics only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.diagnostics"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/diagnostics_paths" />
        </provider>
    </application>
</manifest>
